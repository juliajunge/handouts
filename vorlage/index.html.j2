<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Handouts – Julia Junge</title>
<link rel="stylesheet" href="vorlage/handout.css">
<style>
  /* Bereiche: je eine Farbe aus dem CD – Streifen an den Karten, Nummer und Sprungmarke */
  .bereich--hellgruen { --bereich: var(--jj-green-light); --bereich-text: var(--jj-black); }
  .bereich--orange { --bereich: var(--jj-orange); --bereich-text: var(--jj-black); }
  .bereich--dunkelgruen { --bereich: var(--jj-green-dark); --bereich-text: var(--jj-white); }
  .sprungmarken { display: flex; flex-wrap: wrap; gap: 8px; margin: -16px 0 40px; }
  .sprung { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: .85em; color: var(--jj-black); text-decoration: none; border-radius: 999px; padding: 6px 16px 6px 10px; box-shadow: inset 0 0 0 2px var(--bereich); }
  .sprung:hover { background: var(--bereich); color: var(--bereich-text); }
  .sprung .punkt { width: 12px; height: 12px; border-radius: 999px; background: var(--bereich); }
  .sprung:hover .punkt { background: var(--bereich-text); }
  .bereich { margin: 0 0 48px; scroll-margin-top: 16px; }
  .bereich-kopf { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 16px; }
  .bereich-nr { flex: none; width: 40px; height: 40px; border-radius: 999px; background: var(--bereich, var(--jj-offwhite)); color: var(--bereich-text, var(--jj-black)); font-family: var(--font-display); font-weight: 700; font-size: 1.3em; display: flex; align-items: center; justify-content: center; }
  .bereich-kopf h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.75em; line-height: 1.1; color: var(--jj-green-dark); margin: 4px 0 4px; }
  .bereich-kopf p { margin: 0; color: #333; }
  /* Karten: in einer Reihe gleich groß, Knöpfe immer unten in derselben Reihenfolge */
  .liste { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .liste li { background: var(--jj-offwhite); border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; border-top: 6px solid var(--bereich, var(--jj-offwhite)); }
  .liste .titel { font-family: var(--font-display); font-weight: 700; font-size: 1.3em; line-height: 1.15; color: var(--jj-green-dark); text-decoration: none; }
  .liste a.titel:hover { text-decoration: underline; }
  .liste p { margin: 0; font-size: .9em; color: #333; }
  .liste small { font-size: .8em; color: #333; }
  .liste .aktionen { margin-top: auto; padding-top: 8px; flex-wrap: nowrap; gap: 6px; }
  .liste .aktionen--gruppe { flex-wrap: wrap; }
  .liste .knopf { font-size: .8em; padding: 6px 13px; }
  .liste .label { font-size: .65em; padding: 3px 10px; }
  /* Online-Werkzeug: Rahmen statt Fläche, kein PDF */
  .liste .karte-werkzeug { background: var(--jj-white); box-shadow: inset 0 0 0 2px var(--bereich, var(--jj-green-dark)); }
  .liste .karte-werkzeug .label { background: var(--jj-orange); }
  .liste .karte-werkzeug .knopf { background: var(--jj-orange); }
  .liste .karte-werkzeug .knopf:hover { background: var(--jj-green-light); }
  /* In Arbeit: noch kein Link, leise gestrichelt */
  .liste .karte-demnaechst { background: transparent; box-shadow: inset 0 0 0 2px var(--jj-offwhite); border-top-style: dashed; }
  .liste .karte-demnaechst .label { background: var(--jj-offwhite); }
  .liste .karte-demnaechst .titel { color: #555; }
  .liste .karte-demnaechst p { color: #555; }
  @media (max-width: 560px) {
    .bereich-kopf h2 { font-size: 1.5em; }
  }
  /* Online-Werkzeuge, die in keinem Bereich stehen */
  .werkzeuge { margin: 0 0 48px; }
  .werkzeuge > h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.75em; line-height: 1.1; color: var(--jj-green-dark); margin: 0 0 6px; }
  .werkzeuge > p { margin: 0 0 16px; }
  .werkzeug { border: 2px solid var(--jj-green-dark); border-radius: 16px; padding: 20px 24px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 12px; }
  .werkzeug .label { background: var(--jj-orange); }
  .werkzeug a.titel { font-family: var(--font-display); font-weight: 700; font-size: 1.6em; line-height: 1.1; color: var(--jj-green-dark); text-decoration: none; }
  .werkzeug a.titel:hover { text-decoration: underline; }
  .werkzeug p { margin: 0; }
  .werkzeug small { color: #333; }
  .werkzeug .knopf { background: var(--jj-orange); margin-top: 4px; }
  .werkzeug .knopf:hover { background: var(--jj-green-light); }
</style>
</head>
<body>
<main class="handout">
  <header class="kopf">
    <a href="https://juliajunge.de"><img class="logo" src="vorlage/bilder/logo-julia-junge.svg" alt="Julia Junge"></a>
    <div class="aktionen"><a class="knopf knopf--leise" href="#newsletter">&gt; Newsletter abonnieren</a></div>
  </header>
  <section class="hero">
    <div class="hero-text">
      <span class="label">Material</span>
      <h1>Handouts</h1>
      <div class="strich"></div>
    </div>
  </section>
  {% macro karte(h) %}
    {% if h.art == "werkzeug" %}
    <li class="karte-werkzeug">
      <span class="label">Online-Werkzeug</span>
      <a class="titel" href="{{ h.link }}">{{ h.titel }}</a>
      <p>{{ h.beschreibung }}</p>
      {% if h.hinweis %}<small>{{ h.hinweis }}</small>{% endif %}
      <span class="aktionen"><a class="knopf" href="{{ h.link }}">&gt; {{ h.knopf }}</a></span>
    </li>
    {% elif h.art == "extern" %}
    <li>
      {% if h.etikett %}<span class="label">{{ h.etikett }}</span>{% endif %}
      <a class="titel" href="{{ h.link }}" target="_blank" rel="noopener">{{ h.titel }}</a>
      {% if h.beschreibung %}<p>{{ h.beschreibung }}</p>{% endif %}
      <span class="aktionen"><a class="knopf knopf--leise" href="{{ h.link }}" target="_blank" rel="noopener">&gt; {{ h.knopf }}</a></span>
    </li>
    {% elif h.art == "demnaechst" %}
    <li class="karte-demnaechst">
      <span class="label">In Arbeit</span>
      <span class="titel">{{ h.titel }}</span>
      {% if h.beschreibung %}<p>{{ h.beschreibung }}</p>{% endif %}
    </li>
    {% elif h.handouts %}
    <li>
      <span class="titel">{{ h.titel }}</span>
      {% if h.beschreibung %}<p>{{ h.beschreibung }}</p>{% endif %}
      <span class="aktionen aktionen--gruppe">
        {% for u in h.handouts %}<a class="knopf knopf--leise" href="{{ u.slug }}/">&gt; {{ u.kurztitel }}</a>
        {% endfor %}
      </span>
    </li>
    {% else %}
    <li>
      <a class="titel" href="{{ h.slug }}/">{{ h.titel }}</a>
      {% if h.beschreibung %}<p>{{ h.beschreibung }}</p>{% endif %}
      <span class="aktionen">
        <a class="knopf knopf--leise" href="{{ h.slug }}/">&gt; Webansicht</a>
        <a class="knopf" href="{{ h.slug }}/{{ h.pdf_datei }}" download>&gt; PDF</a>
        {% if h.word_datei %}<a class="knopf" href="{{ h.slug }}/{{ h.word_datei }}" download>&gt; Word</a>{% endif %}
      </span>
    </li>
    {% endif %}
  {% endmacro %}
  {% if bereiche %}
  <nav class="sprungmarken" aria-label="Bereiche">
    {% for b in bereiche %}<a class="sprung bereich--{{ b.farbe }}" href="#{{ b.id }}"><span class="punkt"></span>{{ b.titel }}</a>
    {% endfor %}
  </nav>
  {% endif %}
  {% for b in bereiche %}
  <section class="bereich bereich--{{ b.farbe }}" id="{{ b.id }}">
    <div class="bereich-kopf">
      <span class="bereich-nr">{{ loop.index }}</span>
      <div>
        <h2>{{ b.titel }}</h2>
        {% if b.beschreibung %}<p>{{ b.beschreibung }}</p>{% endif %}
      </div>
    </div>
    <ul class="liste">
    {% for h in b.karten %}{{ karte(h) }}{% endfor %}
    </ul>
  </section>
  {% endfor %}
  {% if handouts %}
  <section class="bereich">
    {% if bereiche %}<div class="bereich-kopf"><div><h2>Weitere Handouts</h2></div></div>{% endif %}
    <ul class="liste">
    {% for h in handouts %}{{ karte(h) }}{% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if werkzeuge %}
  <section class="werkzeuge">
    <h2>Außerdem: zum Online-Ausfüllen</h2>
    <p>Keine Handouts zum Herunterladen, sondern interaktive Seiten. Du beantwortest Fragen und bekommst direkt eine Auswertung.</p>
    {% for w in werkzeuge %}
    <div class="werkzeug">
      <span class="label">Online-Werkzeug</span>
      <a class="titel" href="{{ w.link }}">{{ w.titel }}</a>
      <p>{{ w.beschreibung }}</p>
      {% if w.hinweis %}<small>{{ w.hinweis }}</small>{% endif %}
      <a class="knopf" href="{{ w.link }}">&gt; {{ w.knopf }}</a>
    </div>
    {% endfor %}
  </section>
  {% endif %}
  {% set basis = "" %}{% include "newsletter.html.j2" %}
  <footer class="fuss">
    <div class="drachenlinie" aria-hidden="true"><span></span><img src="vorlage/bilder/logo-julia-junge.svg" alt=""></div>
    <span><a href="https://juliajunge.de">&gt; juliajunge.de</a><a class="fuss-impressum" href="https://www.juliajunge.de/kontakt-und-impressum/">&gt; Impressum und Datenschutz</a></span>
    <span class="fuss-rechts"><span>Autorin: Julia Junge</span><img src="vorlage/bilder/cc-by-sa.png" alt="Lizenz CC BY-SA"></span>
  </footer>
</main>
</body>
</html>
