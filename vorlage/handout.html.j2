<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel }} – Handout von Julia Junge</title>
{% if beschreibung %}<meta name="description" content="{{ beschreibung }}">{% endif %}
<link rel="stylesheet" href="{{ wurzel }}vorlage/handout.css?v={{ css_version }}">
</head>
<body class="{% if stil %}{{ stil }} {% endif %}{% if format == 'quer' %}quer {% endif %}{% if mehrseitig %}mehrseitig{% endif %}">
<main class="handout">
<div class="seite">

  <nav class="zurueck nur-web"><a href="{{ wurzel }}">&larr; zurück zur Übersicht</a></nav>

  <header class="kopf">
    <a href="https://juliajunge.de"><img class="logo" src="{{ wurzel }}vorlage/bilder/logo-julia-junge.svg" alt="Julia Junge"></a>
    <div class="aktionen nur-web">
      <a class="knopf" href="{{ pdf_datei }}" download>&gt; PDF herunterladen</a>
      {% if word_datei %}<a class="knopf" href="{{ word_datei }}" download>&gt; Word zum Bearbeiten</a>{% endif %}
      {% if newsletter %}<a class="knopf knopf--leise" href="#newsletter">&gt; Newsletter abonnieren</a>{% endif %}
    </div>
  </header>

  <section class="hero">
    <div class="hero-text">
      <span class="label">{{ label }}</span>
      <h1>{{ titel }}</h1>
      <div class="strich"></div>
    </div>
    {% if bild %}<img class="hero-bild" src="{{ bild }}" alt="{{ bild_alt }}">{% endif %}
  </section>

  {% set teile = inhalt.split('<!--seitenumbruch-->') %}
  <div class="inhalt">
{{ teile[0]|safe }}
  </div>

  {% macro fuss(klasse) %}
  <footer class="fuss {{ klasse }}">
    <div class="drachenlinie" aria-hidden="true"><span></span><img src="{{ wurzel }}vorlage/bilder/logo-julia-junge.svg" alt=""></div>
    {# Im Druck verweist der Fuß auf den Newsletter: die Adresse nennt die Website gleich mit, ohne zusätzliche Zeile #}
    <span>{% if newsletter and klasse == "fuss--druck" %}<a href="https://www.juliajunge.de/newsletter/">&gt; Newsletter: juliajunge.de/newsletter</a>{% else %}<a href="https://juliajunge.de">&gt; juliajunge.de</a>{% endif %}{% if kurzlink %} · Online: {{ kurzlink }}{% endif %}{% if klasse == "fuss--web" %}<a class="fuss-impressum" href="https://www.juliajunge.de/kontakt-und-impressum/">&gt; Impressum</a><a class="fuss-impressum" href="https://www.juliajunge.de/datenschutzerklaerung/">&gt; Datenschutz</a>{% endif %}</span>
    <span class="fuss-rechts"><span>{% if quelle %}{{ quelle }}{% else %}Autorin: Julia Junge · Stand: {{ stand }} · keine Gewähr{% endif %}</span>{% if lizenz != "cc0" %}<img src="{{ wurzel }}vorlage/bilder/cc-by-sa.png" alt="Lizenz CC BY-SA">{% endif %}</span>
  </footer>
  {% endmacro %}

  {{ fuss("fuss--druck") }}
</div>
{% for teil in teile[1:] %}
<div class="seite seite--folge">
  <div class="inhalt">
{{ teil|safe }}
  </div>
  {{ fuss("fuss--druck") }}
</div>
{% endfor %}

  {% if anhang %}<div class="inhalt">
{{ anhang }}
  </div>{% endif %}

  {% if newsletter %}{% include "newsletter.html.j2" %}{% endif %}

  {{ fuss("fuss--web") }}
</main>
<script>
/* Prompt-Kästen (Codeblöcke): Knopf zum Kopieren, nur Webansicht */
document.querySelectorAll(".inhalt pre").forEach(function (pre) {
  var knopf = document.createElement("button");
  knopf.type = "button";
  knopf.className = "knopf prompt-kopieren nur-web";
  knopf.textContent = "> Prompt kopieren";
  knopf.addEventListener("click", function () {
    navigator.clipboard.writeText(pre.innerText).then(function () {
      knopf.textContent = "Kopiert";
      setTimeout(function () { knopf.textContent = "> Prompt kopieren"; }, 2000);
    });
  });
  pre.parentNode.insertBefore(knopf, pre);
});
</script>
</body>
</html>
